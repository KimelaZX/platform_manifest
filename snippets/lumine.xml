  <project path="packages/modules/Bluetooth" name="platform_packages_modules_Bluetooth" remote="lumine" />
  <project path="packages/modules/Connectivity" name="platform_packages_modules_Connectivity" remote="lumine" />
  <project path="packages/modules/UprobeStats" name="platform_packages_modules_UprobeStats" remote="lumine" />

  <!-- system -->
  <project path="system/core" name="platform_system_core" remote="lumine" />
  <project path="system/sepolicy" name="platform_system_sepolicy" remote="lumine" />
  <project path="system/update_engine" name="platform_system_update_engine" remote="lumine" />

  <!-- vendor -->
  <project path="vendor/extra" name="platform_vendor_extra" remote="lumine" />
